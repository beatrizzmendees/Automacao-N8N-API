    {
      "parameters": {
        "jsCode": "const dados = $input.first().json;\n\nlet html = `\n<h2>Relatório de Cotações</h2>\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\"\nstyle=\"border-collapse:collapse;width:100%;font-family:Arial\">\n<tr style=\"background:#1e3a8a;color:white\">\n<th>Ticker</th>\n<th>Preço (R$)</th>\n<th>Variação Diária (%)</th>\n<th>Faixa de Preço do Dia</th>\n</tr>`;\n\nfor (let i = 0; i < dados.Ticker.length; i++) {\n  const variacao = dados[\"Variação Diária (%)\"][i];\n  const cor = variacao >= 0 ? \"green\" : \"red\";\n\n  html += `\n  <tr>\n    <td>${dados.Ticker[i]}</td>\n    <td>R$ ${dados[\"Preço\"][i].toFixed(2)}</td>\n    <td style=\"color:${cor}\">${variacao > 0 ? \"+\" : \"\"}${variacao.toFixed(2)}%</td>\n    <td>${dados[\"Faixa de Preço do Dia\"][i]}</td>\n  </tr>`;\n}\n\nhtml += `</table>`;\n\nreturn [{\n  json: {\n    assunto: \"Relatório de Cotações\",\n    html_email: html\n  }\n}];"
      },
